<#
.SYNOPSIS
    Makes sure Windows 11 audits Object Access - Other Object Access Events (success).

.NOTES
    Author          : Felix
    LinkedIn        : N/A
    GitHub          : https://github.com/felix2470/
    Date Created    : 04/22/2025
    Last Modified   : 10/22/2026
    Version         : 1.2
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-AU-000083

.TESTED ON
    Date(s) Tested  : 10/22/2026 1:33 AM
    Tested By       : Felix
    Systems Tested  : Windows 11
    PowerShell Ver. : 5.1.26100.9711

.USAGE
    Steps to run the script in PowerShell:
    1. Right-click the Start button and select "Terminal (Admin)" or
       "Windows PowerShell (Admin)". Admin is required because the
       script changes protected system settings.
    2. Go to the folder that holds the script and allow scripts to run
       in this window only:
           cd C:\path\to\folder
           Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass
    3. Run the script:
           .\remediate-WN11-AU-000083.ps1
       (Or paste the code below straight into the Admin window and press Enter.)
    4. Read the output. You should see one of:
           Setting Other Object Access Events auditing to Success...
           Other Object Access Events  Success
    5. To double-check, run:
           auditpol /get /subcategory:"Other Object Access Events"
       It should show Success (or Success and Failure).
       NOTE: if your machine has the setting SCENoApplyLegacyAuditPolicy at 0,
       fix that first (set it to 1), or the old audit rules can override this one.
    6. Restart the computer and rescan to confirm the finding now passes.
#>

$subcategory = "Other Object Access Events"

try {
    # Check current setting
    $current = auditpol /get /subcategory:"$subcategory" | Select-String $subcategory

    if ($current -match "Success") {
        Write-Host "$subcategory already audits Success. No action needed."
    } else {
        Write-Host "Setting $subcategory auditing to Success..."
        auditpol /set /subcategory:"$subcategory" /success:enable | Out-Null
        $after = auditpol /get /subcategory:"$subcategory" | Select-String $subcategory
        Write-Host $after.ToString().Trim()
    }
} catch {
    Write-Error "Failed to apply WN11-AU-000083: $_"
}
